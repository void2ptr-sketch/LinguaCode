{
  "name": "lingua-code",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --configuration coverage --no-watch --no-progress",
    "test:ci": "ng test --no-watch --no-progress",
    "verify": "npm run lint && npm run audit:fsd && npm run audit:rules && npm run check:imports && npm run audit:barrels && npm run sync:hanzi && npm run build:prod && npm run test:ci",
    "audit": "npm audit --audit-level=high",
    "audit:fsd": "node scripts/audit-fsd.mjs",
    "audit:rules": "node scripts/audit-rules.mjs",
    "audit:barrels": "node scripts/audit-barrels.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "lint": "ng lint",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier     --check \"src/**/*.{ts,html,scss,css,json}\" \"*.{json,md,js}\" \"docs/**/*.md\"",
    "format:fix": "prettier --write \"src/**/*.{ts,html,scss,css,json}\" \"*.{json,md,js}\" \"docs/**/*.md\"",
    "sync:hanzi": "node scripts/sync-hanzi-assets.mjs",
    "export:content-seed": "node scripts/content-seed/perl-interview-idea-parser.test.mjs && node scripts/content-seed/perl-interview-tags.test.mjs && node scripts/export-content-seed.mjs",
    "import:perl-idea": "node scripts/import-perl-interview-idea.mjs",
    "import:course-bundle": "node scripts/import-course-bundle.mjs",
    "generate:radicals-course": "node scripts/generate-radicals-course.mjs && node scripts/export-content-seed.mjs",
    "export:course-pdf": "node scripts/export-course-pdf.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.0",
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.1",
    "highlight.js": "^11.11.1",
    "jspdf": "^4.2.1",
    "marked": "^18.0.11",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "angular-eslint": "22.2.0",
    "canvas": "^3.2.3",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "hanzi-writer-data": "^2.0.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.8.4",
    "source-map-explorer": "^2.5.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^5.0.3",
    "webpack-dev-middleware": "^8.3.0"
  }
}
